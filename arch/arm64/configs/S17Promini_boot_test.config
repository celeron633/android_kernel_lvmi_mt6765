# S17 stock front/main sensors, including the ported IMX278 driver.
CONFIG_CUSTOM_KERNEL_IMGSENSOR="gc5025sub_mipi_raw imx278_mipi_raw"
CONFIG_LOCALVERSION="-s17-bringup-r18-sensors"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOG_BUF_SHIFT=21
CONFIG_CHARGER_PSC5425E=y
CONFIG_MTK_MIR3DA=y
CONFIG_GSENSOR_PROXIMITY=y

# GPIO/pinctrl state and IRQ masking diagnostics for touch bring-up.
CONFIG_DEBUG_FS=y
CONFIG_GENERIC_IRQ_DEBUGFS=y

# Permit explicit debug-boot permissive mode; default remains enforcing.
CONFIG_SECURITY_SELINUX_DEVELOP=y
