# Boot/display/touch test; the missing IMX278 main camera is deferred.
CONFIG_CUSTOM_KERNEL_IMGSENSOR="gc5025sub_mipi_raw"
CONFIG_LOCALVERSION="-s17-bringup-r9-cachelog"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOG_BUF_SHIFT=21

# Permit explicit debug-boot permissive mode; default remains enforcing.
CONFIG_SECURITY_SELINUX_DEVELOP=y
