# Boot/display/touch test; the missing IMX278 main camera is deferred.
CONFIG_CUSTOM_KERNEL_IMGSENSOR="gc5025sub_mipi_raw"
CONFIG_LOCALVERSION="-s17-bringup-r11-connectivity"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOG_BUF_SHIFT=21

# GPIO/pinctrl state and IRQ masking diagnostics for touch bring-up.
CONFIG_DEBUG_FS=y
CONFIG_GENERIC_IRQ_DEBUGFS=y

# Permit explicit debug-boot permissive mode; default remains enforcing.
CONFIG_SECURITY_SELINUX_DEVELOP=y
