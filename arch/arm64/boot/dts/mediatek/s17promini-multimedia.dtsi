		clock-names = "CAM_MDP", "IMG_DL_RELAY", "IMG_DL_ASYNC_TOP";
		phandle = <0x3c>;
	};

	nfc {
		compatible = "mediatek,nfc-gpio-v2";
		gpio-rst = <0xac>;
		gpio-rst-std = <0x1f 0xac 0x00>;
		gpio-irq = <0x0a>;
		gpio-irq-std = <0x1f 0x0a 0x00>;
		phandle = <0xcf>;
	};

	irq_nfc {
		status = "okay";
		interrupts = <0x0a 0x04 0x0a 0x00>;
		interrupt-parent = <0x1f>;
		compatible = "mediatek,irq_nfc-eint";
		phandle = <0xd0>;
	};

	mtee_svp {
		compatible = "medaitek,svp";
		phandle = <0xd1>;
	};

	disp_mutex0@14001000 {
		compatible = "mediatek,disp_mutex0";
		reg = <0x00 0x14001000 0x00 0x1000>;
		interrupts = <0x00 0xd2 0x08>;
		phandle = <0x45>;
	};

