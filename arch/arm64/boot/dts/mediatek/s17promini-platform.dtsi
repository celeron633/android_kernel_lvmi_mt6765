		compatible = "mediatek,io_cfg_rt";
		reg = <0x00 0x10002c00 0x00 0x200>;
		phandle = <0x1e>;
	};

	pericfg@10003000 {
		compatible = "mediatek,pericfg", "syscon";
		reg = <0x00 0x10003000 0x00 0x1000>;
		#clock-cells = <0x01>;
		phandle = <0x4e>;
	};

	efuse_dbg@10004000 {
		compatible = "mediatek,efuse_dbg";
		reg = <0x00 0x10004000 0x00 0x1000>;
	};

	gpio {
		GPIO_SIM1_HOT_PLUG = <0x1f 0x2f 0x00>;
		GPIO_SIM2_HOT_PLUG = <0x1f 0x2e 0x00>;
		GPIO_SIM1_SIO = <0x1f 0x28 0x00>;
		GPIO_SIM1_SRST = <0x1f 0x27 0x00>;
		GPIO_SIM1_SCLK = <0x1f 0x26 0x00>;
		GPIO_SIM2_SCLK = <0x1f 0x25 0x00>;
